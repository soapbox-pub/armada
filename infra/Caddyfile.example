# Armada — single-domain reverse proxy (Caddy reference).
#
# The relay (multi-tenant zooid: NIP-29 Nostr websocket + NIP-11 + LiveKit /
# Concord / push endpoints) and the web client SPA share ONE origin per
# community (e.g. armada.example.com), split by request path and by WebSocket
# upgrade. zooid routes to a community by the inbound Host header, which MUST
# equal that community's TOML `host` field — Caddy's reverse_proxy preserves the
# inbound Host by default, so no extra header config is needed. Each community
# gets its own site block (or use a wildcard + one config TOML per host).
# See AGENTS.md for the full hosting story (LiveKit/TURN, SNI passthrough, etc.).
#
# Copy this file, replace the placeholders, and either drop it in your Caddy
# sites directory or `import` it from your main Caddyfile:
#
#   armada.example.com   → a community host (must match its config TOML `host`)
#   you@example.com      → ACME contact email
#   RELAY_HOST:5577      → the zooid relay HTTP/WS endpoint
#   SFU_HOST:7880        → the LiveKit SFU signaling endpoint
#   CLIENT_HOST:8080     → the web client's nginx container
#
# In the reference single-LXC deploy these are all one host (e.g. 192.168.1.150).

armada.example.com {
	tls you@example.com

	# LiveKit signaling websocket. The JS SDK appends "/rtc" to LIVEKIT_PUBLIC_URL,
	# so it connects to wss://armada.example.com/rtc. (Setting LIVEKIT_PUBLIC_URL
	# to ".../rtc" would make the SDK request "/rtc/rtc" and 404 — see AGENTS.md
	# "LiveKit URL gotcha".)
	handle /rtc* {
		reverse_proxy SFU_HOST:7880
	}

	# Relay NIP-29 AV-space LiveKit token + capability endpoints (NIP-98 authed).
	# This also covers zooid's LiveKit webhook (/.well-known/nip29/livekit/webhook),
	# normally reached internally by the SFU rather than the public edge.
	handle /.well-known/nip29/* {
		reverse_proxy RELAY_HOST:5577
	}

	# Concord serverless voice: the blind LiveKit token broker + its capability
	# probe (GET /.well-known/concord/voice → 204). MUST route to the relay;
	# without this rule the request falls through to the SPA, which returns
	# index.html (HTTP 200, HTML), and the client fails with a JSON parse error
	# when it tries to read the token response.
	handle /.well-known/concord/* {
		reverse_proxy RELAY_HOST:5577
	}

	# Web Push notification gateway: VAPID key + subscription registration
	# (NIP-98 authed PUT/DELETE). MUST route to the relay — like the Concord
	# route above, otherwise the request hits the SPA and the client gets HTML
	# instead of JSON when fetching the VAPID key.
	handle /.well-known/armada/* {
		reverse_proxy RELAY_HOST:5577
	}

	# zooid management REST API, when mounted on-origin via RELAY_API_PATH=/api.
	# This is how the client's "Create a community" flow provisions new virtual
	# relays (NIP-98 authed, whitelisted pubkeys). Keeps the API on the same
	# origin — no dedicated subdomain. Drop this block if you don't enable the
	# management API (or if you serve it on a dedicated RELAY_API_HOST instead).
	handle /api/* {
		reverse_proxy RELAY_HOST:5577
	}

	# Relay Nostr websocket + NIP-11: requests that upgrade to a websocket, or
	# ask for the relay information document, go to the relay at the root path.
	@relay {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	@nip11 header Accept application/nostr+json
	handle @relay {
		reverse_proxy RELAY_HOST:5577
	}
	handle @nip11 {
		reverse_proxy RELAY_HOST:5577
	}

	# Everything else: the web client SPA (served by its nginx container).
	handle {
		reverse_proxy CLIENT_HOST:8080
	}

	# Optional access log. NOTE: under some sandboxes Caddy can't CREATE a new
	# log file on reload (it errors with "permission denied" on the path). If so,
	# `touch` the file and `chown` it to the caddy user before reloading.
	log {
		output file /var/log/caddy/armada.access.log {
			roll_size 50mb
			roll_keep 3
			roll_keep_for 720h
		}
	}
}
