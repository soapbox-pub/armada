# Copy to .env and fill in. Generate secrets with:
#   LIVEKIT_API_SECRET: openssl rand -hex 32
#
# The relay is multi-tenant zooid: each COMMUNITY is a TOML config file under
# infra/config/ (one per host), NOT an env var. ../start.sh seeds a default
# community (infra/config/localhost:5577.toml) on first run. To add more
# communities, drop another <host>.toml in infra/config (hot-reloaded) or use
# zooid's management REST API (set RELAY_API_HOST below). Per-community settings
# — the relay's secret key, owner pubkey, roles, and LiveKit credentials — live
# in those TOML files. See server/README.md for the config schema.

# ── Management REST API (optional) ────────────────────────────────────────────
# When set, zooid exposes a NIP-98-authed JSON API on this host for creating /
# updating / deleting community configs at runtime. Leave empty to disable.
RELAY_API_HOST=
# Comma-separated hex pubkeys allowed to call the management API.
RELAY_API_WHITELIST=

# ── Notifications (Web Push) ──────────────────────────────────────────────────
# The relay delivers push notifications for messages/mentions/replies/reactions
# and DMs directly to subscribed browsers (no external push service). VAPID keys
# authenticate those pushes; leave both EMPTY to auto-generate and persist a
# per-community keypair on first run. Pin them (shared across communities) to
# keep public keys stable across data wipes — rotating a public key invalidates
# every browser's existing subscription.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=

# ── LiveKit ───────────────────────────────────────────────────────────────────
# API key + secret shared between the relay (which mints LiveKit JWTs) and the
# LiveKit SFU (which verifies them). Anyone holding both can mint a token for
# ANY room, bypassing every relay-side authorization check — so the secret must
# be high-entropy and kept secret. start.sh generates both on first run and
# writes them into the default community's TOML; if you set them by hand use
# `openssl rand -hex 32` for the secret. They must match the per-community
# `[livekit]` credentials in infra/config/*.toml.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit websocket URL as reachable from browsers. For a single-domain reverse
# proxy, set this to wss://<domain> (the LiveKit JS SDK appends its own /rtc;
# the relay normalizes a trailing /rtc away). This seeds the default community's
# TOML `[livekit] server_url`. Default localhost works as-is.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ── LiveKit media / WebRTC (advanced; see AGENTS.md "Voice / LiveKit") ─────────
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
LIVEKIT_IFACE=eth0
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=turn.localhost
LIVEKIT_CERT_DIR=./certs/turn
LIVEKIT_TURN_PORT=5349

# ── Client ────────────────────────────────────────────────────────────────────
APP_NAME=Armada
# Host port the web client is served on.
CLIENT_PORT=8080
# Comma-separated pinned relay URLs baked into the client build. With the
# multi-tenant relay, each pinned URL is a community host (e.g.
# wss://teamA.example.com). For the localhost quickstart this is the single
# default community.
PLATFORM_RELAYS=ws://localhost:5577
# Default app relays for non-NIP-29 traffic (profiles, lists). Users can edit
# these in Settings; set to an internal relay (or your platform relay) for a
# fully air-gapped deployment.
APP_RELAYS=wss://relay.ditto.pub,wss://relay.dreamith.to

# Default mic audio-processing toggles for voice calls (true/false). These seed
# each user's in-call audio settings; users can override them per device. All
# default to true (LiveKit/browser defaults) for good noise/echo handling.
# DEFAULT_NOISE_SUPPRESSION=true
# DEFAULT_ECHO_CANCELLATION=true
# DEFAULT_AUTO_GAIN_CONTROL=true
