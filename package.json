{
  "name": "armada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "scripts/dev-electron.sh",
    "gen:icons": "node scripts/gen-icons.mjs",
    "build": "vite build -l error && cp dist/index.html dist/404.html",
    "build:profile": "VITE_PROFILE=1 npm run build",
    "perf:profile": "node scripts/perf-profile.mjs",
    "build:electron-db": "vite build -l error -c vite.config.electron.ts",
    "build:electron-update": "vite build -l error -c vite.config.electron-update.ts",
    "build:electron": "npm run build:electron-db && npm run build:electron-update",
    "deploy:nsite": "npm run build && nsyte deploy dist --prompt-sec",
    "test": "tsc --noEmit && eslint --cache . && vitest run --passWithNoTests --reporter=dot && vite build -l error && npm run build:electron",
    "test:perf": "ARMADA_TEST_PERF=1 vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
